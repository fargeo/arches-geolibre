{
    "name": "arches-geolibre",
    "version": "0.0.1",
    "private": true,
    "description": "GeoLibre plugin for editing Arches geospatial data",
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "install:geolibre": "npm run build && node scripts/install-geolibre-plugin.mjs",
        "test": "vitest --run --project unit",
        "ts:check": "vue-tsc --noEmit",
        "prettier:check": "prettier . --check",
        "prettier:fix": "prettier . --write",
        "test:integration": "vitest --run --project integration",
        "test:e2e": "playwright test",
        "gettext:extract": "rm -f src/arches_geolibre/locale/en/app.po && vue-gettext-extract && node scripts/normalize-catalog-header.mjs",
        "gettext:compile": "vue-gettext-compile",
        "package:zip": "npm run build && node scripts/package-plugin.mjs",
        "demo:record": "node scripts/record-demo.mjs"
    },
    "dependencies": {
        "@openvue/themes": "1.0.0",
        "openvue": "1.0.0",
        "vue": "3.5.43",
        "vue3-gettext": "4.0.1"
    },
    "devDependencies": {
        "@playwright/test": "1.64.0",
        "@types/geojson": "7946.0.16",
        "@types/node": "24.19.2",
        "@vitejs/plugin-vue": "6.0.10",
        "@vue/test-utils": "2.5.1",
        "jsdom": "30.1.2",
        "maplibre-gl": "6.14.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "vite": "8.3.4",
        "vitest": "5.0.4",
        "vue-tsc": "3.3.13"
    }
}
